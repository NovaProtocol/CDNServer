# Documentation of required env vars, there is NO .env file.
# Values are provided by compose interpolation at deploy time (${VAR:?} in compose.yaml),
# or exported in your shell locally. See reference/conventions/entrypoints.md.
DEPLOYMENT_TYPE=debug
SECRET_KEY=change-me
MYSQL_USER=cdn
MYSQL_PASS=change-me
MYSQL_DATABASE=cdnserver

# /manage is gated by GateKeeper (a custom_password rule on the cdn route), NOT by this
# app, the app holds no auth (house "naked behind the gate" contract). The password the
# owner supplied lives on the GateKeeper rule, hashed in GateKeeper's DB.
